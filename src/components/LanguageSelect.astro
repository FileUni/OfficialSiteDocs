---
import { DOCS_LOCALE_OPTIONS } from '../i18n/locales';
import {
  createLocaleMenuControlStyle,
  createStaticLocaleMenuItems,
  LOCALE_MENU_CLASSNAMES,
  LOCALE_MENU_TRANSLATION_ICON_PATHS,
  type StaticLocaleMenuItem,
  resolveCurrentPathLocale,
  type SupportedLocale,
} from '../i18n/core';

type LocaleOption = {
  code: SupportedLocale;
  label: string;
  pathPrefix: string;
};

const currentPath = Astro.url.pathname;
const localeOptions: LocaleOption[] = DOCS_LOCALE_OPTIONS;
const currentLocale = resolveCurrentPathLocale(currentPath, localeOptions);
const menuItems = createStaticLocaleMenuItems(localeOptions, currentLocale);
const controlStyle = createLocaleMenuControlStyle();
---

<starlight-lang-select>
  <button
    type="button"
    class={`fu-lang-toggle ${LOCALE_MENU_CLASSNAMES.trigger}`}
    style={controlStyle}
    data-current-lang={currentLocale.code}
    aria-expanded="false"
    aria-haspopup="menu"
    aria-label={Astro.locals.t('languageSelect.accessibleLabel')}
  >
    <span class="fu-lang-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        {LOCALE_MENU_TRANSLATION_ICON_PATHS.map((path) => (
          <path d={path}></path>
        ))}
      </svg>
    </span>
    <span class="fu-lang-current-label">{currentLocale.label}</span>
  </button>
  <div class={`fu-lang-menu ${LOCALE_MENU_CLASSNAMES.menu}`} style={controlStyle} hidden>
    {menuItems.map((option: StaticLocaleMenuItem) => (
      <button
        type="button"
        class:list={[
          'fu-lang-menu-item',
          LOCALE_MENU_CLASSNAMES.item,
          option.selected && 'is-active',
        ]}
        data-lang-value={option.code}
        data-lang-path-prefix={option.pathPrefix}
        role="menuitemradio"
        aria-checked={option.selected}
      >
        <span class="fu-lang-label">{option.label}</span>
      </button>
    ))}
  </div>
</starlight-lang-select>

<script>
  import { initDocsLanguageSelect } from '../scripts/language-select';

  initDocsLanguageSelect();
</script>
